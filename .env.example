# ---------------------------------------------------------------------------
# CallMind Intelligence - example environment variables
# Copy to .env for local (non-Docker) development:  cp .env.example .env
# Never commit real secrets. Docker Compose supplies its own service URLs.
# Leave API keys blank; enter them manually in .env when needed.
# ---------------------------------------------------------------------------

NODE_ENV=development

# API
PORT=8080
CORS_ORIGIN=http://localhost:5174,http://localhost:5173
LOG_LEVEL=info

# Infrastructure (host ports used by docker compose)
MONGODB_URI=mongodb://localhost:27018/callmind
REDIS_URL=redis://localhost:6380

# Recording storage (local filesystem; Docker uses /app/storage)
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=26214400
MAX_FILES_PER_UPLOAD=20
WORKSPACE_ID=default

# Worker
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg

# Frontend dev server proxy target (server-side only, not exposed to browser)
VITE_API_PROXY_TARGET=http://localhost:8080

# Google Gemini — conversation analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Speech-to-text
STT_STRATEGY=language-aware
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_MAX_BYTES=26214400
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_STT_MAX_BYTES=26214400
