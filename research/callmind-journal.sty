\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{callmind-journal}[2026/11/27 CallMind journal formatting]

\RequirePackage[a4paper,left=30mm,right=29mm,top=26mm,bottom=26mm,headheight=14pt,headsep=7mm,footskip=14mm]{geometry}
\RequirePackage{fontspec}
\RequirePackage[table]{xcolor}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{caption}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{colortbl}
\RequirePackage{graphicx}
\RequirePackage{microtype}
\RequirePackage{amsmath,amssymb}
\RequirePackage{url}
\RequirePackage{cite}
\RequirePackage{hyperref}
\RequirePackage{etoolbox}
\RequirePackage{needspace}

\definecolor{navy}{HTML}{003399}
\definecolor{linkblue}{HTML}{0084EF}
\definecolor{headerorange}{HTML}{ED7D31}
\definecolor{tableborder}{HTML}{B7B7B7}
\definecolor{headergray}{HTML}{D0D0D0}

\hypersetup{
  colorlinks=true,
  linkcolor=navy,
  citecolor=navy,
  urlcolor=linkblue,
  filecolor=navy,
  anchorcolor=navy,
  pdfborder={0 0 0}
}

\setmainfont{DejaVuSans}[
  Path=fonts/,
  Extension=.ttf,
  UprightFont=DejaVuSans,
  BoldFont=DejaVuSans-Bold,
  ItalicFont=DejaVuSans-Oblique,
  BoldItalicFont=DejaVuSans-BoldOblique,
  Scale=1.03
]
\setmonofont{DejaVu Sans Mono}[Scale=0.92]
\newfontfamily\journalheaderfont{Carlito}[
  Path=fonts/,
  Extension=.ttf,
  UprightFont=*-Regular,
  BoldFont=*-Bold,
  ItalicFont=*-Italic,
  BoldItalicFont=*-BoldItalic
]

\renewcommand{\normalsize}{\fontsize{9.5pt}{11.5pt}\selectfont}
\DeclareMathSizes{9.5}{9.5}{7}{6}
\AtBeginDocument{\normalsize\color{navy}}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5.5pt plus 1pt minus 0.5pt}
\setlength{\emergencystretch}{2em}
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[C]{\journalheaderfont\fontsize{11pt}{12pt}\selectfont\color{headerorange}%
  \textit{CallMind Intelligence}, Mini Project--II Research Paper}
\fancyfoot[C]{%
  \begin{tabular}{c}
    \setlength{\fboxsep}{2pt}%
    \setlength{\fboxrule}{0.5pt}%
    \fbox{\parbox[c][26pt][c]{34pt}{\centering\journalheaderfont
      \fontsize{8pt}{9pt}\selectfont\color{black}\thepage}}\\[-1pt]
    \textcolor{black}{\rule{0.5pt}{8pt}}
  \end{tabular}}

\titleformat{\section}
  {\needspace{4\baselineskip}\normalfont\bfseries\color{navy}\fontsize{9.5pt}{11.5pt}\selectfont}
  {\thesection.}{0.5em}{}
\titlespacing*{\section}{0pt}{10pt}{3pt}

\titleformat{\subsection}
  {\needspace{5\baselineskip}\normalfont\itshape\color{navy}\fontsize{9.5pt}{11.5pt}\selectfont}
  {\hspace{3.2em}\thesubsection.}{0.4em}{}
\titlespacing*{\subsection}{0pt}{6pt}{2pt}

\captionsetup{
  font={color=navy},
  labelfont={color=navy},
  labelsep=period,
  justification=raggedright,
  singlelinecheck=false,
  skip=4pt
}

\newcommand{\ResearchPaperLabel}{%
  {\fontsize{23pt}{26pt}\selectfont\bfseries\color{navy}Research paper\par}}
\newcommand{\JournalTitle}[1]{%
  \begingroup\centering
    {\fontsize{13.5pt}{16pt}\selectfont\bfseries\color{navy}#1\par}
  \endgroup}
\newcommand{\JournalAuthor}[1]{%
  {\fontsize{9.5pt}{12pt}\selectfont\bfseries\color{navy}#1\par}}
\newcommand{\JournalAffiliation}[1]{%
  {\fontsize{9.5pt}{12pt}\selectfont\bfseries\color{navy}#1\par}}
\newcommand{\JournalEmail}[1]{%
  {\fontsize{9.5pt}{12pt}\selectfont\color{linkblue}#1\par}}
\newcommand{\JournalSeparator}{%
  \vspace{3pt}\noindent\textcolor{navy}{\rule{\linewidth}{0.4pt}}\vspace{2pt}}

\newcommand{\journaltablestyle}{%
  \fontsize{7.5pt}{9pt}\selectfont\color{navy}%
  \arrayrulecolor{tableborder}%
  \setlength{\arrayrulewidth}{0.4pt}%
  \renewcommand{\arraystretch}{1.12}}
\newcommand{\journalheadrow}{\rowcolor{headergray}}
\newcommand{\journalth}[1]{\textbf{#1}}
\newcommand{\journaltablefont}{\fontsize{7.5pt}{9pt}\selectfont\color{navy}}

\patchcmd{\thebibliography}
  {\usecounter{enumiv}}
  {\usecounter{enumiv}%
   \setlength{\leftmargin}{1.6em}%
   \setlength{\labelwidth}{1.2em}%
   \setlength{\itemindent}{0pt}%
   \setlength{\labelsep}{0.4em}}
  {}
  {\PackageWarning{callmind-journal}{Could not patch bibliography indentation}}
